{
  "schema": "gat26.g83.preregistration.v1",
  "stage": "G83",
  "title": "Final deadline-bounded dense-overlap inference audit, conservative A10G proxy, and conditional official validation submission",
  "preregistered_before_any_real_candidate_prediction_or_metric": true,
  "base_commit": "73262cfd444d96f2d04d97b725bef733b0da2337",
  "base_branch": "g82-generalization-finetune",
  "branch": "g83-dense-overlap-audit",
  "private_main_must_remain": "81cb90ac8b906e412a65d3232b048c70a6377b71",
  "public_repo_must_remain": "43672e13e400d0bc97814eae1c8c86c17d64eabe",
  "merge_into_main": false,

  "candidates": ["C0", "D25"],
  "no_other_candidate_permitted": true,
  "candidate_definitions": {
    "C0": {
      "model": "frozen ResEnc-M five-fold, equal mean region probabilities",
      "tile_step_size": 0.5,
      "use_gaussian": true,
      "use_mirroring": false,
      "threshold": 0.5,
      "reconstruction": "hierarchy-safe ET subset TC subset WT",
      "cleanup": "none",
      "presence_gate": "none"
    },
    "D25": {
      "identical_to_C0_except": "tile_step_size",
      "tile_step_size": 0.25
    }
  },
  "exact_scientific_difference": "tile_step_size: 0.5 -> 0.25",
  "allowed_tile_steps": [0.5, 0.25],
  "prohibited": [
    "tile steps 0.20, 0.30, 0.33, 0.40 or any adaptive step",
    "threshold search", "TTA", "mirroring", "checkpoint_best", "checkpoint soup",
    "G82 checkpoints or blends", "G81 postprocessing",
    "connected-component filtering", "presence gates", "region-specific thresholds",
    "validation-image adaptation", "pseudo-labeling", "training or fine-tuning",
    "architecture changes", "selecting a different policy after seeing D25 results",
    "new weights of any kind"
  ],

  "rationale_recorded_before_results": "Denser overlapping sliding windows average more Gaussian-weighted predictions per voxel, which can reduce patch-boundary variance. The change is purely an inference-time aggregation choice: it is independent of tumour labels, cohort, validation identities and leaderboard feedback, and it creates no new trainable parameters. Improvement is NOT claimed or guaranteed; the preregistered gates decide.",

  "splits": {
    "calibration_folds": [0, 1, 2],
    "n_calibration_subjects": 811,
    "confirmation_folds": [3, 4],
    "n_confirmation_subjects": 540,
    "confirmation_opens_only_after_candidate_freeze_commit": true,
    "confirmation_executes_once_only": true,
    "every_subject_predicted_by_the_model_that_excluded_it": true,
    "split_sha256_prefix": "16014d7b8830"
  },

  "metric": {
    "official_components": ["DSC_ET", "DSC_TC", "DSC_WT", "NSD_ET", "NSD_TC", "NSD_WT"],
    "utility": "U_tau = mean(DSC_ET, DSC_TC, DSC_WT, NSD_ET, NSD_TC, NSD_WT)",
    "nsd_tolerances_explicit": [0.5, 1.0],
    "tolerance_never_implicit": true,
    "evaluator": {"panoptica": "2.1.4", "brats_evaluation": "0.0.8",
                  "path": "preserved read-only environment; site-packages is never modified"},
    "aggregation": ["official skip-NaN with realized denominators", "common support"],
    "tau1_label": "controlled sensitivity at the organizer-confirmed tolerance, NOT an exact reproduction of the final scorer",
    "bootstrap": {"seed": 20260730, "resamples": 10000, "unit": "subject",
                  "recompute_means_and_denominators_inside_each_resample": true},
    "baseline_wins_ties": true
  },

  "baseline_reproduction_gate": {
    "purpose": "C0 must be reproduced before any D25 evaluation",
    "required_tau05": {"DSC_ET": 0.864632, "DSC_TC": 0.917205, "DSC_WT": 0.928174,
                       "NSD_ET": 0.655812, "NSD_TC": 0.621476, "NSD_WT": 0.573399},
    "required_tau10": {"DSC_ET": 0.864632, "DSC_TC": 0.917205, "DSC_WT": 0.928174,
                       "NSD_ET": 0.895995, "NSD_TC": 0.878328, "NSD_WT": 0.866410},
    "required_denominators": {"ET": 806, "TC": 809, "WT": 811},
    "required_evaluator_errors": 0,
    "on_failure": "the baseline is not reproducible under the C0 definition in this specification; retain C0 and fail closed"
  },

  "runtime_only_optimization": {
    "is_a_scientific_candidate": false,
    "permitted_order": [
      "retain all five predictors if measured VRAM stays under the gate",
      "otherwise preload checkpoint states and reuse one network while preserving checkpoint and accumulation order",
      "otherwise retain the original release implementation"
    ],
    "must_not_alter": ["ensemble arithmetic", "preprocessing", "mixed precision",
                       "checkpoint order", "output reconstruction",
                       "probability accumulation order"],
    "equivalence_requirements": {
      "segmentation_voxel_arrays": "exactly equal",
      "geometry": "exactly equal",
      "labels": "exactly equal",
      "names_and_output_count": "equal",
      "raw_region_probabilities": "exactly equal or max abs difference <= 1e-7",
      "threshold_crossings": "no voxel crosses 0.5 differently",
      "errors": 0
    },
    "on_failure": "abandon the optimized path without editing frozen release files; D25 may continue on the original path and must still satisfy the runtime gate"
  },

  "calibration_gates_all_required": {
    "delta_U_common_tau1_min": 0.0005,
    "delta_U_common_tau05_min": 0.0,
    "official_policy_deltas_positive_at_both_tolerances": true,
    "bootstrap_prob_delta_U_common_tau1_positive_min": 0.95,
    "tau1_paired_95_interval_lower_bound_strictly_above_zero": true,
    "min_nonnegative_common_support_components_tau1": 4,
    "min_nonnegative_common_support_components_tau05": 4,
    "max_dsc_component_regression": 0.001,
    "max_nsd_component_regression": 0.002,
    "min_folds_with_nonnegative_tau1_delta": 2,
    "min_fold_delta": -0.0015,
    "et_zero_dsc_must_not_increase": true,
    "total_region_wise_zero_dsc_must_not_increase": true,
    "unique_subject_zero_dsc_must_not_increase": true,
    "lesion_fn_must_not_increase": true,
    "max_lesion_fp_increase_fraction": 0.05,
    "no_denominator_only_gain": true,
    "exact_membership_required": true,
    "evaluator_errors_required": 0,
    "independent_aggregate_recomputation_tolerance": 1e-12,
    "on_failure": "G83_RETAIN_C0_D25_CALIBRATION_FAILURE"
  },

  "confirmation_gates_all_required": {
    "pooled_delta_U_common_tau1_min": 0.0005,
    "pooled_delta_U_common_tau05_positive": true,
    "official_policy_deltas_positive_at_both_tolerances": true,
    "bootstrap_prob_positive_min": 0.90,
    "min_individual_fold_delta": -0.0015,
    "min_nonnegative_pooled_components_tau1": 4,
    "max_dsc_component_regression": 0.001,
    "max_nsd_component_regression": 0.002,
    "et_total_and_unique_subject_zero_dsc_must_not_increase": true,
    "pooled_lesion_fn_must_not_increase": true,
    "max_lesion_fp_increase_fraction": 0.05,
    "no_denominator_only_gain": true,
    "exact_membership_and_zero_evaluator_errors": true,
    "all_five_folds": {
      "delta_U_common_tau1_min": 0.0005,
      "delta_U_common_tau05_positive": true,
      "bootstrap_prob_positive_min": 0.95,
      "effect_directions_must_agree": true,
      "no_tail_or_integrity_gate_may_become_false": true
    },
    "on_failure": "G83_RETAIN_C0_D25_CONFIRMATION_FAILURE"
  },

  "runtime_gate_hf_a10g_proxy": {
    "flavor": "a10g-large",
    "gpu": "exactly one NVIDIA A10G, 24 GB VRAM",
    "environment_approx": "12 vCPU, 46 GB RAM, 200 GB disk",
    "label": "conservative A10G proxy; slightly fewer CPU/RAM resources than the organizer specification; NEVER call this A10G-2 exact acceptance",
    "smoke_cases": 2,
    "benchmark_cases": 30,
    "benchmark_selection": "deterministic and outcome-independent, chosen from input geometry only, before any runtime result is read",
    "requirements": {
      "inference_errors": 0,
      "peak_reserved_vram_gib_max": 21,
      "no_cpu_or_ram_exhaustion": true,
      "outputs_pass_g80_validation_gates": true,
      "c0_step_0_5_equivalence_still_true": true,
      "projected_451_case_runtime_hours_max": 9,
      "safety_factor": 0.20
    },
    "projection_formula": "startup_seconds + 451 * max(p95_case_seconds, mean_case_seconds + 2*stdev_case_seconds), then multiplied by 1.20",
    "never_upload_to_hf": ["training data", "labels", "case identifiers",
