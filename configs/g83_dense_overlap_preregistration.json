    "on_missing_auth_or_path": "G83_D25_INTERNAL_ADVANCE_AWAITING_HF_A10G_PROXY",
    "on_failure": "G83_RETAIN_C0_D25_RUNTIME_OR_CONTAINER_FAILURE"
  },

